# คัดลอกเป็น .env:  cp .env.example .env   แล้วใส่ API key ของตัวเอง (ห้าม commit ไฟล์ .env)
# แหล่งไหนไม่มี key จะถูก skip และ DAG ยังรวมข้อมูลจากแหล่งที่เหลือต่อ

# https://developer.tomtom.com  (สมัครฟรี ไม่ต้องผูกบัตร ~2,500 request/วัน)
TOMTOM_API_KEY=

# https://platform.here.com  (สร้าง project > REST API key)
HERE_API_KEY=

# Waze Live Map (web scraping, ไม่ต้องใช้ key)
ENABLE_WAZE=true

# เกณฑ์ตรวจคุณภาพข้อมูล (ไม่ผ่าน -> branch ไป quarantine)
DQ_MIN_VALID_ROWS=10
DQ_MAX_REJECT_RATIO=0.3

# Linux: ใส่ผลของ `id -u`  (Windows/macOS ใช้ค่าเดิมได้)
AIRFLOW_UID=50000
