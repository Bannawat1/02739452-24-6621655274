# คัดลอกเป็น .env:  cp .env.example .env   (Windows: copy .env.example .env)
# ทุกแหล่งข้อมูลไม่ต้องใช้ API key

# เปิด/ปิดแต่ละแหล่ง (ปิด = task เป็น skipped ใช้ทดลองกรณีแหล่งหายได้)
ENABLE_TOMTOM_INDEX=true
ENABLE_LONGDO=true
ENABLE_TRAFFY=true

# จำนวนเรื่องล่าสุดที่ดึงจาก Traffy Fondue ต่อรอบ
TRAFFY_LIMIT=500

# เกณฑ์ตรวจคุณภาพข้อมูล (ไม่ผ่าน -> branch ไป quarantine)
DQ_MIN_VALID_ROWS=10
DQ_MAX_REJECT_RATIO=0.3

# Linux: ใส่ผลของ `id -u`  (Windows/macOS ใช้ค่าเดิมได้)
AIRFLOW_UID=50000
